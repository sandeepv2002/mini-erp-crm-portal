{
  "info": {
    "name": "Mini ERP + CRM Operations Portal API",
    "description": "Comprehensive Postman collection for the Mini ERP + CRM REST API backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://mini-erp-crm-portal-za5a.onrender.com" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health & Status",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        },
        {
          "name": "Root Overview",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Login - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.token) {",
                  "  pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@verveerp.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login - Sales",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@verveerp.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "3. Customers (CRM)",
      "item": [
        {
          "name": "List Customers (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customers?page=1&limit=10&status=all&type=all",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Customer By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customers/c1111111-1111-1111-1111-111111111111",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/customers",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Metro Builders & Infra\",\n  \"mobile\": \"+91 99887 76655\",\n  \"email\": \"contact@metroinfra.in\",\n  \"business_name\": \"Metro Infra Ltd\",\n  \"gst_number\": \"29AAECM1234F1Z8\",\n  \"customer_type\": \"Wholesale\",\n  \"status\": \"Active\",\n  \"address\": \"Sector 4, Outer Ring Road, Bengaluru\",\n  \"follow_up_date\": \"2026-08-20\"\n}"
            }
          }
        },
        {
          "name": "Add Follow-up Note",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/customers/c1111111-1111-1111-1111-111111111111/notes",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Discussed wholesale discounts for Q3. Customer agreed to place an order of 50 units next week.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Products & Inventory",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?page=1&limit=20",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/products",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"High Pressure Ball Valve 1-inch\",\n  \"sku\": \"VALV-008\",\n  \"category\": \"Valves\",\n  \"unit_price\": 1850.00,\n  \"current_stock\": 30,\n  \"min_stock_alert\": 8,\n  \"location\": \"Rack A-4\"\n}"
            }
          }
        },
        {
          "name": "Adjust Stock (IN/OUT Audit Log)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/stock-movements",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"a1111111-1111-1111-1111-111111111111\",\n  \"quantity\": 15,\n  \"movement_type\": \"IN\",\n  \"reason\": \"Received supplier purchase order #PO-2026-88\"\n}"
            }
          }
        },
        {
          "name": "List Stock Movement Audit Log",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/stock-movements?page=1&limit=20",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "5. Sales Challans & Invoicing",
      "item": [
        {
          "name": "List Sales Challans",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/challans?page=1&limit=10",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Create Sales Challan (Multi-product)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/challans",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"c1111111-1111-1111-1111-111111111111\",\n  \"status\": \"Draft\",\n  \"items\": [\n    {\n      \"product_id\": \"a1111111-1111-1111-1111-111111111111\",\n      \"product_name_snapshot\": \"Industrial Valve 2-inch\",\n      \"sku_snapshot\": \"VALV-001\",\n      \"unit_price_snapshot\": 1250.00,\n      \"quantity\": 2,\n      \"line_total\": 2500.00\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Confirm Challan (Atomic Stock Deduction)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/challans/cc222222-2222-2222-2222-222222222222/confirm",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Download PDF Invoice",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/challans/cc111111-1111-1111-1111-111111111111/pdf?token={{token}}"
          }
        }
      ]
    }
  ]
}
